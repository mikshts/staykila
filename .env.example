# StayKila Environment Variables Configuration Template

# 1. Supabase Client Configuration (Vite Frontend)
# URL of your Supabase project (e.g. https://xxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon public key for Supabase client
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Supabase Server Configuration (Optional for local testing / scripts)
# Service role key (used for administrative tasks, bypasses RLS - KEEP SECRET!)
VITE_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. PayMongo Integration Configuration (Set these as Edge Function Secrets)
# Set these in Supabase using the CLI: `supabase secrets set PAYMONGO_SECRET_KEY=...`
# Or via the Supabase Dashboard -> Edge Functions -> Secrets
PAYMONGO_SECRET_KEY=your-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-secret
